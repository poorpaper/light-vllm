[Unit]
Description=light-vllm inference service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=light-vllm
Group=light-vllm
WorkingDirectory=/opt/light-vllm

# 站点参数只保存在这一份文件中，避免 unit 与 env 各自维护默认值。
EnvironmentFile=/etc/light-vllm/light-vllm.env
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CACHE_HOME=/var/cache/light-vllm
Environment=TRITON_CACHE_DIR=/var/cache/light-vllm/triton
Environment=TORCHINDUCTOR_CACHE_DIR=/var/cache/light-vllm/torchinductor

ExecStart=/opt/light-vllm/.venv/bin/light-vllm-serve \
    --host 0.0.0.0 \
    --port ${LIGHT_VLLM_PORT} \
    --architecture ${LIGHT_VLLM_ARCHITECTURE} \
    --loader safetensors \
    --weights ${LIGHT_VLLM_MODEL_PATH} \
    --tokenizer ${LIGHT_VLLM_MODEL_PATH} \
    --served-model-name ${LIGHT_VLLM_SERVED_MODEL_NAME} \
    --request-timeout-seconds ${LIGHT_VLLM_REQUEST_TIMEOUT_SECONDS} \
    --device ${LIGHT_VLLM_DEVICE} \
    --dtype ${LIGHT_VLLM_DTYPE} \
    --runtime engine \
    --engine-process \
    --kv-reservation blocks \
    --paged-attention-backend triton \
    --max-num-sequences ${LIGHT_VLLM_MAX_NUM_SEQUENCES} \
    --max-num-scheduled-tokens ${LIGHT_VLLM_MAX_NUM_SCHEDULED_TOKENS} \
    --kv-block-size ${LIGHT_VLLM_KV_BLOCK_SIZE} \
    --kv-cache-memory-fraction ${LIGHT_VLLM_KV_CACHE_MEMORY_FRACTION}

Restart=on-failure
RestartSec=3s
TimeoutStopSec=3min
LimitMEMLOCK=infinity
CacheDirectory=light-vllm

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
