# 模型父目录只读挂载到容器 /models。
LIGHT_VLLM_MODEL_DIR=/data/models
LIGHT_VLLM_MODEL_NAME=Qwen2.5-Coder-7B-Instruct
LIGHT_VLLM_SERVED_MODEL_NAME=Qwen2.5-Coder-7B-Instruct
LIGHT_VLLM_REQUEST_TIMEOUT_SECONDS=300

LIGHT_VLLM_IMAGE=light-vllm:dev
LIGHT_VLLM_VERSION=dev
LIGHT_VLLM_VCS_REF=unknown
LIGHT_VLLM_HTTP_PORT=8000

# 下面是需要通过同一 workload 做 A/B 后再调整的性能参数。
LIGHT_VLLM_ARCHITECTURE=qwen2.5
LIGHT_VLLM_DTYPE=bfloat16
LIGHT_VLLM_MAX_NUM_SEQUENCES=16
LIGHT_VLLM_MAX_NUM_SCHEDULED_TOKENS=512
LIGHT_VLLM_KV_BLOCK_SIZE=16
LIGHT_VLLM_KV_CACHE_MEMORY_FRACTION=0.8

# 与 compose.tp2.yaml 一起使用；首版只支持单节点 TP。
LIGHT_VLLM_TENSOR_PARALLEL_SIZE=2
LIGHT_VLLM_DISTRIBUTED_TIMEOUT_SECONDS=120
