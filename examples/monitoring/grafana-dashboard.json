{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(light_vllm_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(light_vllm_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model}} p50",
          "refId": "B"
        }
      ],
      "title": "TTFT",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(light_vllm_inter_token_latency_seconds_bucket[5m])))",
          "legendFormat": "{{model}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(light_vllm_inter_token_latency_seconds_bucket[5m])))",
          "legendFormat": "{{model}} p50",
          "refId": "B"
        }
      ],
      "title": "Inter-token latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "tokens/sec"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "sum by (model) (rate(light_vllm_generation_tokens_total[1m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "输出吞吐",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "sum by (model) (light_vllm_requests_waiting)",
          "legendFormat": "{{model}} waiting",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (light_vllm_requests_running)",
          "legendFormat": "{{model}} running",
          "refId": "B"
        }
      ],
      "title": "请求队列",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "targets": [
        {
          "expr": "sum by (model) (light_vllm_waiting_max_remaining_tokens)",
          "legendFormat": "{{model}} waiting",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (light_vllm_running_max_remaining_tokens)",
          "legendFormat": "{{model}} running",
          "refId": "B"
        }
      ],
      "title": "Token-aware 队列",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}, "unit": "percentunit"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {
          "expr": "max by (model) (light_vllm_kv_cache_usage_ratio)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "KV cache 使用率",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model, model_tokens_computed_le) (rate(light_vllm_engine_step_seconds_bucket[5m])))",
          "legendFormat": "{{model}} <= {{model_tokens_computed_le}} tokens",
          "refId": "A"
        }
      ],
      "title": "Engine step latency p95",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["light-vllm", "inference"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "light-vllm 性能观测",
  "uid": "light-vllm-performance",
  "version": 1
}
